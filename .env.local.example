# Copy to .env.local and fill in. NEVER commit .env.local.

# From Supabase Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Supabase's newer Vercel integration may provide this instead of ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role key — server-only. Used for the platform-operator pages and
# admin RPC calls that need to bypass RLS. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Supabase's newer Vercel integration may provide this instead.
SUPABASE_SECRET_KEY=sb_secret_...

# Where the owner portal lives (used in invitation emails)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Canonical public URLs and tenant-domain routing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APEX_DOMAIN=portier369.com

# Scheduled Vercel jobs fail closed without this value. Generate a long,
# random secret and configure the same value in every deployed environment.
CRON_SECRET=

# HMAC salt for privacy-preserving public-endpoint rate-limit keys. If omitted,
# CRON_SECRET is used. Set a separate long random value in production.
RATE_LIMIT_SECRET=

# Keep outbound webhook creation disabled until the deployment has an
# SSRF-safe, retrying delivery worker. The Developer Hub fails closed.
WEBHOOK_DELIVERY_ENABLED=false

# Durable SMS delivery through a Twilio Messaging Service. Keep disabled until
# Advanced Opt-Out and both /status and /inbound public webhooks are configured.
SMS_DELIVERY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_BASE_URL=https://portier369.com

# Physical letter fulfillment through Lob. The return-address fields are
# required before the worker can submit a queued piece.
PHYSICAL_MAIL_DELIVERY_ENABLED=false
LOB_API_KEY=
PHYSICAL_MAIL_FROM_NAME=
PHYSICAL_MAIL_FROM_ADDRESS_LINE1=
PHYSICAL_MAIL_FROM_ADDRESS_LINE2=
PHYSICAL_MAIL_FROM_CITY=
PHYSICAL_MAIL_FROM_STATE=
PHYSICAL_MAIL_FROM_ZIP=

# Stripe payments and webhook verification (server-only except publishable key).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# true in Production, false in Preview/test. Webhooks fail closed on mismatch.
STRIPE_LIVEMODE=false

# Plaid bank feeds. PLAID_ENV is one of sandbox, development, or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Transactional email.
RESEND_API_KEY=

# Public Piper marketing assistant. Server-only.
DEEPSEEK_API_KEY=

# Encrypts each portfolio's BYO AI credential before database storage. Generate
# an independent random value of at least 32 characters. During rotation, put
# the old value in AI_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS until keys are re-saved.
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# Optional local-only switch. Never enable in production.
LOCAL_PREVIEW_MODE=false

# Isolated staging verification only. These values must point to the staging
# project below; the seed and cleanup scripts refuse every other project ref.
STAGING_SUPABASE_URL=https://zalfkrtjeswvfmucicea.supabase.co
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_ANON_KEY=
STAGING_TEST_PASSWORD=
PORTIER369_STAGING_CONFIRM=zalfkrtjeswvfmucicea
# Required only for cleanup; the script still verifies exact marked records.
PORTIER369_CODEX_TEST_CLEANUP_CONFIRM=CODEX_TEST_PORTIER369_V1
